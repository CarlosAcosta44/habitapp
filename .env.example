# ── API Backend (NestJS) ──────────────────────────────────────────────────────
# URL del backend. En producción: https://api.tudominio.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Supabase (solo si el frontend aún accede directamente a alguna tabla) ─────
# Después de la migración completa al backend, estas variables pueden eliminarse
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key

# ── Observabilidad Sentry (opcional) ─────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
